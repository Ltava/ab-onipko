{
  "version": 2,
  "name": "ab-onipko",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://r.jina.ai; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.liqpay.ua"
      }
    },
    { "src": "/poslugy", "dest": "/poslugy.html" },
    { "src": "/dyakuyu", "dest": "/dyakuyu.html" },
    { "src": "/oferta", "dest": "/oferta.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
